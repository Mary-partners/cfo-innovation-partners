# Copy this file to .env.local for local `npm run dev`, and set the same
# keys as Environment Variables in the Vercel project (Project Settings ->
# Environment Variables). Never commit a real .env file.
#
# Full walkthrough: /docs/setup.md

# --- Supabase project (Project Settings -> API) ---------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Bypasses Row Level Security — never expose to the browser,
# never prefix with NEXT_PUBLIC_. Only used for admin bootstrap tasks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Database (Project Settings -> Database -> Connection string) ---------
# Pooled connection (port 6543, Transaction mode) — used by the running app.
DATABASE_URL="postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — used only by `prisma migrate` in CI/locally.
DIRECT_URL="postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres"

# --- App -------------------------------------------------------------------
# Base URL this deployment is reachable at (used to build the Supabase auth
# redirect URL). Set to your Vercel production URL / custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
